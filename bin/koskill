#!/usr/bin/env node
import { spawn } from 'node:child_process';
import * as path from 'node:path';
import * as fs from 'node:fs';
import { fileURLToPath } from 'node:url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const rootDir = path.resolve(__dirname, '..');
const tsEntry = path.join(rootDir, 'src', 'cli', 'index.ts');
const jsEntry = path.join(rootDir, 'dist', 'cli', 'index.js');

const useJs = fs.existsSync(jsEntry) && !fs.existsSync(tsEntry);
const entry = useJs ? jsEntry : tsEntry;

let tsxLoader = 'tsx';
try {
  tsxLoader = import.meta.resolve('tsx');
} catch {
  // Fallback to bare tsx if resolution fails
}

const args = useJs
  ? [entry, ...process.argv.slice(2)]
  : ['--import', tsxLoader, entry, ...process.argv.slice(2)];

const child = spawn(process.execPath, args, {
  stdio: 'inherit',
  env: process.env,
});

process.on('SIGINT', () => child.kill('SIGINT'));
process.on('SIGTERM', () => child.kill('SIGTERM'));

child.on('exit', (code, signal) => {
  if (signal) {
    process.kill(process.pid, signal);
  } else {
    process.exit(code ?? 0);
  }
});
